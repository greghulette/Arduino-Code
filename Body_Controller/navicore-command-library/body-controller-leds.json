        { "code": "1", "label": "Red" },
        { "code": "2", "label": "Yellow" },
        { "code": "3", "label": "Green" },
        { "code": "4", "label": "Cyan" },
        { "code": "5", "label": "Blue" },
        { "code": "6", "label": "Magenta" },
        { "code": "7", "label": "Orange" },
        { "code": "8", "label": "White" }
      ]
    },
    "bcSpeed3": {
      "values": [
        { "code": "1", "label": "Fast" },
        { "code": "2", "label": "Medium" },
        { "code": "3", "label": "Slow" }
      ]
    },
    "bcKnMode": {
      "values": [
        { "code": "1", "label": "Single color" },
        { "code": "2", "label": "Palette cycle" },
        { "code": "3", "label": "Red / Blue" },
        { "code": "4", "label": "Green / Yellow" },
        { "code": "5", "label": "Color wheel" }
      ]
    },
    "bcVuMode": {
      "values": [
        { "code": "1", "label": "Classic gradient (green→red)" },
        { "code": "2", "label": "Fade color 1 → color 2" },
        { "code": "3", "label": "Color wheel" },
        { "code": "4", "label": "Single color (brightness = level)" }
