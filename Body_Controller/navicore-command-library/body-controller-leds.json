    },
    "bcColor": {
      "values": [
        { "code": "0", "label": "Off (black)" },
        { "code": "1", "label": "Red" },
        { "code": "2", "label": "Yellow" },
        { "code": "3", "label": "Green" },
        { "code": "4", "label": "Cyan" },
        { "code": "5", "label": "Blue" },
        { "code": "6", "label": "Magenta" },
        { "code": "7", "label": "Orange" },
        { "code": "8", "label": "White" }
