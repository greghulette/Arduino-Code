{
  "schema": "navicore-command-library/v1",
  "version": "2.0.0",
  "_note": "PRIVATE command-library board for the NaviCore config tool. Import via the command library's Import… button; stored in your browser (localStorage), re-loads on refresh. deliver:'wcb' + aliasMatch:['BC'] unicast to whichever WCB advertises 'BC' (id floats; dest.target '2' is the offline fallback). Every template is ':L'-prefixed so the BC ESP32 forwards the rest to the ATMEGA2560 LED controller. Each effect is its OWN command with only its real parameters — derived by reading the effect FUNCTIONS in Body_Controller_ATMEGA2560.ino, not just the dispatch table. command[1] is a MODE for some effects (knightRider/VU/dualbounce/dueling/random/shortCircuit) and a SPEED for others; colors apply only in the modes noted on each field's label. Color 0 = Off. NOTE: aliasMatch needs the BC ESP32 on the WCB mesh (WCB_Client) advertising 'BC'; the current sketch uses custom ESP-NOW, so wire up WCB_Client first (or rely on the fixed dest.target).",
  "enums": {
    "bcLedZone": {
      "values": [
        { "code": "A", "label": "All (Coin, LDP, VU, Maint)" },
        { "code": "E", "label": "Every logic + panel" },
        { "code": "V", "label": "VU" },
        { "code": "L", "label": "Logic Display Panel (LDP)" },
        { "code": "C", "label": "Coin Slots" },
        { "code": "M", "label": "Maintenance" },
        { "code": "D", "label": "Data Port Panel" },
        { "code": "I", "label": "CBI logics" },
        { "code": "B", "label": "CBI + Data Port" },
        { "code": "F", "label": "Coin + LDP + VU" },
        { "code": "G", "label": "LDP + Maint + VU" },
        { "code": "H", "label": "VU + Data Panel logics" },
        { "code": "J", "label": "VU + Data Panel + CBI" },
        { "code": "K", "label": "LDP + Coin + VU + CBI + Data Panel" },
        { "code": "N", "label": "LDP + Maint + VU" },
        { "code": "Q", "label": "Maint + Coin + VU" },
        { "code": "R", "label": "LDP + Maint + Coin" },
        { "code": "T", "label": "LDP + Maint" },
        { "code": "U", "label": "Maint + Coin" },
        { "code": "W", "label": "Maint + VU" },
        { "code": "X", "label": "LDP + Coin" },
        { "code": "Y", "label": "Coin + VU" },
        { "code": "Z", "label": "LDP + VU" }
      ]
    },
