  },
  "boards": [
    {
      "id": "bc-leds",
      "name": "Body Controller — LEDs",
      "kind": "wcb-verb",
      "deliver": "wcb",
      "aliasMatch": ["BC"],
      "dest": { "target": "2" },
      "commands": [
        {
          "id": "bcled.effect",
          "name": "LED effect (default colors)",
          "category": "LED",
          "template": ":L{zone}{effect}{speed}",
          "params": [
            { "name": "zone", "label": "Zone", "enum": "bcLedZone", "required": true },
            { "name": "effect", "label": "Effect", "enum": "bcEffect", "required": true },
            { "name": "speed", "label": "Speed (0-9)", "type": "int", "min": 0, "max": 9, "default": 5, "required": true }
          ],
          "examples": [":LV045"]
        },
        {
          "id": "bcled.effectcolor",
          "name": "LED effect + colors",
          "category": "LED",
          "template": ":L{zone}{effect}{speed}{color1}{color2}",
          "params": [
            { "name": "zone", "label": "Zone", "enum": "bcLedZone", "required": true },
            { "name": "effect", "label": "Effect", "enum": "bcEffect", "required": true },
            { "name": "speed", "label": "Speed (0-9)", "type": "int", "min": 0, "max": 9, "default": 5, "required": true },
            { "name": "color1", "label": "Primary color", "enum": "bcColor", "default": "5", "required": true },
            { "name": "color2", "label": "Secondary color", "enum": "bcColor", "default": "1", "required": true }
          ],
          "examples": [":LV04551"]
        },
        {
          "id": "bcled.raw",
          "name": "Raw BC command (advanced)",
          "category": "Advanced",
          "template": ":L{raw}",
          "params": [
            { "name": "raw", "label": "BC command after :L (e.g. A05, or P0512 to program)", "default": "A00", "required": true }
          ],
          "examples": [":LA00"]
        }
      ]
    }
  ]
}
